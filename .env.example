# Copy to .env and fill in. Never commit .env.

# ---- LLM (OpenAI-compatible). Leave OPENAI_API_KEY empty to run fully offline with the
# deterministic heuristic provider (rule-based extraction/routing + feature-hashing embeddings).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model output (Neo4j vector index dimension).
EMBEDDING_DIMENSIONS=1536

# ---- PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=change-me-postgres

# ---- Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---- Redis
REDIS_URL=redis://redis:6379/0

# ---- JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Uploads
MAX_UPLOAD_SIZE_MB=25

# ---- Rate limits ("<n>/<second|minute|hour|day>")
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/hour

# ---- Retrieval / agent
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=8
RETRIEVAL_THRESHOLD=0.55
RERANKER=score
AGENT_MAX_RETRIES=3

# ---- App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501
