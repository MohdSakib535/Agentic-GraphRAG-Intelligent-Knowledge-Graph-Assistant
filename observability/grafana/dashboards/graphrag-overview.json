{
  "uid": "graphrag-overview",
  "title": "Agentic GraphRAG - Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "graphrag"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphrag_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphrag_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(graphrag_http_requests_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Chat p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(graphrag_chat_turn_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Answer cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphrag_cache_events_total{namespace=\"answer\",result=\"hit\"}[1h])) / clamp_min(sum(rate(graphrag_cache_events_total{namespace=\"answer\"}[1h])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP latency p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(graphrag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chat turns by strategy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (strategy) (rate(graphrag_chat_turns_total[5m]))",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(graphrag_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query rewrites / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(graphrag_agent_query_rewrites_total[5m]) * 60",
          "legendFormat": "rewrites"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit/miss",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, result) (rate(graphrag_cache_events_total[5m]))",
          "legendFormat": "{{namespace}} {{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingestion jobs by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "graphrag_ingestion_jobs",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Chat-with-CSV queries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (planner, outcome) (rate(graphrag_dataset_queries_total[5m]))",
          "legendFormat": "{{planner}} {{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Answer feedback",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rating) (increase(graphrag_feedback_total[1h]))",
          "legendFormat": "{{rating}}"
        }
      ]
    }
  ]
}